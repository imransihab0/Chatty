/// Template for Cloudflare R2 credentials.
/// Copy this file to `r2_credentials.dart` and fill in your actual credentials:
/// cp lib/services/r2_credentials.dart.example lib/services/r2_credentials.dart
class R2Credentials {
  static const String accountId = String.fromEnvironment(
    'R2_ACCOUNT_ID',
    defaultValue: 'YOUR_CLOUDFLARE_ACCOUNT_ID',
  );
  static const String bucketName = String.fromEnvironment(
    'R2_BUCKET_NAME',
    defaultValue: 'chatty-media',
  );
  static const String accessKeyId = String.fromEnvironment(
    'R2_ACCESS_KEY_ID',
    defaultValue: 'YOUR_R2_ACCESS_KEY_ID',
  );
  static const String secretAccessKey = String.fromEnvironment(
    'R2_SECRET_ACCESS_KEY',
    defaultValue: 'YOUR_R2_SECRET_ACCESS_KEY',
  );
  static const String publicDomain = String.fromEnvironment(
    'R2_PUBLIC_DOMAIN',
    defaultValue: 'https://pub-your-domain.r2.dev',
  );
}
